{
  "server": {
    "host": "0.0.0.0",
    "port": 8880,
    "cors_origins": ["http://localhost:3000", "http://127.0.0.1:3000"]
  },
  "client_auth": {
    "enabled": false,
    "keys_file": null,
    "clock_skew_seconds": 60,
    "nonce_ttl_seconds": 300,
    "max_requests_per_minute": 120
  },
  "cost_guard": {
    "max_ai_tasks_per_client_minute": 10,
    "max_ai_tasks_per_client_day": 200,
    "max_ai_tasks_global_day": 1000
  },
  "ai_quota": {
    "enabled": true,
    "base_url": "https://uiflow2.m5stack.com/m5stack/internal/v1/aiQuota",
    "client_id": "uiflow-aiflow-prod",
    "model": "deepseek-pro",
    "timeout_seconds": 5,
    "max_attempts": 2
  },
  "web_gateway": {
    "require_same_origin": true,
    "cookie_secure": false,
    "trusted_proxy_ips": ["127.0.0.1", "::1"],
    "max_requests_per_session_minute": 120,
    "max_requests_per_ip_minute": 300,
    "max_ai_tasks_per_session_minute": 3,
    "max_ai_tasks_per_session_day": 20,
    "max_ai_tasks_per_ip_day": 100
  },
  "storage": {
    "data_dir": "./projects_data_v3"
  },
  "claude": {
    "model": null,
    "fallback_model": null,
    "supports_image_input": true,
    "context_window_tokens": 258000,
    "max_turns": 30,
    "max_budget_usd": null,
    "effort": "high",
    "permission_mode": "dontAsk",
    "sandbox_enabled": true,
    "allowed_tools": ["Read", "Write", "Edit", "Glob", "Grep", "Bash"],
    "skills": ["uiflow2-coder", "m5stack-assistant", "aiflow-device-push"]
  },
  "skills": {
    "directory": "./skills"
  },
  "mcp": {
    "m5stack_enabled": true,
    "m5stack_url": "https://mcp.m5stack.com/sse"
  },
  "device_push": {
    "base_url": "https://uiflow2.m5stack.com/m5stack/",
    "timeout_seconds": 120
  },
  "capacity": {
    "max_sessions": 100,
    "session_active_window_seconds": 60,
    "max_concurrent_tasks": 4,
    "max_queued_tasks": 20
  },
  "tasks": {
    "heartbeat_seconds": 10,
    "agent_stall_seconds": 120,
    "event_retention": 10000
  },
  "telemetry": {
    "tls_enabled": false,
    "schema_version": 2,
    "tls_endpoint": "tls-cn-beijing.volces.com",
    "tls_region": "cn-beijing",
    "tls_topic_id": "d66e9a86-bbd5-419b-91db-d5aef9a4a42a",
    "source": "aiflow-conversation",
    "filename": "conversation-trace.log",
    "batch_size": 20,
    "batch_wait_seconds": 0.05,
    "upload_timeout_seconds": 5,
    "shutdown_timeout_seconds": 2,
    "retry_base_seconds": 1,
    "retry_max_seconds": 300,
    "max_payload_bytes": 131072
  },
  "uploads": {
    "max_bytes": 10485760
  },
  "messages": {
    "max_attachments": 6,
    "max_attachment_bytes": 10485760,
    "max_total_bytes": 20971520
  },
  "asr": {
    "enabled": false,
    "url": "wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_nostream",
    "resource_id": "volc.seedasr.sauc.duration",
    "timeout_seconds": 30,
    "segment_duration_ms": 200
  }
}
