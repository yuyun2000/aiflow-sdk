# Copy to .env.local and replace the placeholders. .env.local is ignored by Git.
# The provider must implement the Anthropic Messages API expected by Claude Code.

# Keep this value for access from other devices on the trusted LAN.
AIFLOW_HOST="0.0.0.0"

# Allow slow or heavily loaded servers enough time to finish importing and initialize SQLite.
# AIFLOW_START_TIMEOUT_SECONDS="60"

# Enable after HTTPS is terminated by Nginx/Caddy/load balancer in production.
# AIFLOW_WEB_COOKIE_SECURE="true"

ANTHROPIC_BASE_URL="https://your-provider.example.com"

# Use exactly one authentication style, according to the provider.
ANTHROPIC_AUTH_TOKEN="replace-with-bearer-token"
# ANTHROPIC_API_KEY="replace-with-api-key"

# Use the exact model ID exposed by the third-party provider.
AIFLOW_CLAUDE_MODEL="replace-with-provider-model-id"

# Claude Code compacts before this context size (258000 tokens by default).
AIFLOW_CLAUDE_CONTEXT_WINDOW_TOKENS="258000"
# Maximum Agent conversation turns (30 by default).
AIFLOW_CLAUDE_MAX_TURNS="30"

# Set to false for text-only models such as DeepSeek. Image files remain available
# to UIFlow2 code and resource deployment, but the Agent cannot read their contents.
AIFLOW_CLAUDE_SUPPORTS_IMAGE_INPUT="true"

# Optional Volcengine SAUC no-stream ASR. Credentials are read only from this
# ignored environment file; choose API key or legacy App-Key + Access-Key.
AIFLOW_ASR_ENABLED="false"
AIFLOW_ASR_API_KEY="replace-with-volcengine-speech-api-key"
# AIFLOW_ASR_APP_KEY="replace-with-legacy-app-key"
# AIFLOW_ASR_ACCESS_KEY="replace-with-legacy-access-key"
# AIFLOW_ASR_RESOURCE_ID="volc.seedasr.sauc.duration"
# AIFLOW_ASR_URL="wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_nostream"
# AIFLOW_ASR_TIMEOUT_SECONDS="30"
# AIFLOW_ASR_SEGMENT_DURATION_MS="200"

# Optional Volcengine TLS conversation trace upload. Credentials and the
# pseudonym key must stay in this ignored environment file, never in JSON/code.
TLS_LOG_ENABLED="0"
TLS_ACCESS_KEY="replace-with-volcengine-access-key"
TLS_SECRET_KEY="replace-with-volcengine-secret-key"
TLS_PSEUDONYM_KEY="replace-with-a-random-32-byte-or-longer-secret"
# LOG_TLS_TOPIC_ID="override-server-config-topic-id"
# TLS_LOG_SCHEMA_VERSION="2"
# TLS_LOG_BATCH_SIZE="20"
# TLS_LOG_BATCH_WAIT_SECONDS="0.05"
# TLS_UPLOAD_TIMEOUT_SECONDS="5"
# TLS_LOG_SHUTDOWN_TIMEOUT_SECONDS="2"

# Split-core deployments may configure AIFLOW_CLIENT_AUTH_* manually. The default
# anonymous web BFF creates an in-memory internal key and never sends it to browsers.
