# Independent AIFlow analytics process
AIFLOW_ANALYTICS_HOST="0.0.0.0"
AIFLOW_ANALYTICS_PORT="5090"
AIFLOW_ANALYTICS_TIMEZONE="Asia/Shanghai"
AIFLOW_ANALYTICS_DATA_DIR="./data"
AIFLOW_ANALYTICS_LOG_LEVEL="INFO"

# Prompts, model thinking, and tool results are sensitive. Keep auth enabled
# unless this port is isolated inside a trusted private network.
AIFLOW_ANALYTICS_AUTH_DISABLED="false"
AIFLOW_ANALYTICS_API_TOKEN="replace-with-at-least-24-random-characters"

# Volcengine TLS SearchLogsV2. Use read-only credentials.
TLS_ENDPOINT="tls-cn-beijing.volces.com"
TLS_REGION="cn-beijing"
TLS_ACCESS_KEY="replace-with-read-only-access-key"
TLS_SECRET_KEY="replace-with-read-only-secret-key"
LOG_TLS_TOPIC_ID="d66e9a86-bbd5-419b-91db-d5aef9a4a42a"
TLS_LOG_SCHEMA_VERSION="2"
AIFLOW_ANALYTICS_TLS_QUERY="event:aiflow_conversation_trace"
AIFLOW_ANALYTICS_TLS_PAGE_SIZE="100"
AIFLOW_ANALYTICS_TLS_MAX_PAGES="10000"
AIFLOW_ANALYTICS_TLS_TIMEOUT_SECONDS="10"

# Historical days sync once; the current window refreshes with overlap.
AIFLOW_ANALYTICS_START_DATE="2026-08-01"
AIFLOW_ANALYTICS_SYNC_ON_STARTUP="true"
AIFLOW_ANALYTICS_SYNC_INTERVAL_SECONDS="60"
AIFLOW_ANALYTICS_SYNC_OVERLAP_MINUTES="15"
AIFLOW_ANALYTICS_DEFAULT_RANGE_DAYS="7"
